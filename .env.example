# Telegram (optional: without them the bot only logs to the console)
TELEGRAM_TOKEN=123456789:your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-chat-id

# Market (ccxt exchange id, public data only in paper mode)
EXCHANGE=binanceusdm
SYMBOLS=ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT,AVAX/USDT,LINK/USDT

# Strategy
MIN_SCORE=10
ATR_STOP=1.0
REWARD_RISK=1.5
PARTIAL_AT_R=1.0

# Risk
INITIAL_CAPITAL=1000
RISK_PER_TRADE=0.01
LEVERAGE=10
MAX_POSITIONS=4
MAX_DRAWDOWN=0.25

# Costs
MAKER_FEE=0.0002
TAKER_FEE=0.0005
STOP_SLIPPAGE=0.0003
